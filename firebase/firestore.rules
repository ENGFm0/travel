rules_version = '2';

// BoardingPass — Firestore Security Rules (client-first, no backend).
// The app talks to Firestore directly, so these rules ARE the authority.
// Deny-by-default; trip access is resolved from the trip doc's `memberUids`
// (also used by the "my trips" query) and per-trip role from the member doc.
//
// Global role (optional) comes from a custom claim request.auth.token.role
// (USER | ADMIN | SUPER_ADMIN); absent for normal users.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function role() { return signedIn() && 'role' in request.auth.token ? request.auth.token.role : 'USER'; }
    function isAdmin() { return role() == 'ADMIN' || role() == 'SUPER_ADMIN'; }
    function isSuperAdmin() { return role() == 'SUPER_ADMIN'; }

    // Trip access derived from the trip document.
    function tripDoc(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
    function tripExists(tripId) { return exists(/databases/$(database)/documents/trips/$(tripId)); }
    function isTripMember(tripId) { return signedIn() && tripExists(tripId) && uid() in tripDoc(tripId).memberUids; }
    function isTripOwner(tripId) { return signedIn() && tripExists(tripId) && tripDoc(tripId).ownerUid == uid(); }

    // ── Users / profiles ───────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow create, update: if uid() == userId;
      allow delete: if uid() == userId || isSuperAdmin();
    }

    // ── Trips (tenant root) ────────────────────────────────────────────────
    match /trips/{tripId} {
      allow read: if signedIn() && (uid() in resource.data.memberUids || isAdmin());
      allow create: if signedIn()
                    && request.resource.data.ownerUid == uid()
                    && request.resource.data.memberUids == [uid()]
                    && request.resource.data.status == 'ACTIVE';
      // Owner may change anything (incl. ownerUid/memberUids for invites/transfer).
      // A non-owner member may update other fields but not ownership/membership.
      allow update: if isTripOwner(tripId)
                    || (uid() in resource.data.memberUids
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && request.resource.data.memberUids == resource.data.memberUids);
      allow delete: if isTripOwner(tripId) || isSuperAdmin();

      // Members: owner manages; a member may create/delete their OWN doc (join via
      // trip creation / leave). Reads for any member.
      match /members/{memberId} {
        allow read: if isTripMember(tripId) || isAdmin();
        allow create, update: if isTripOwner(tripId) || uid() == memberId;
        allow delete: if isTripOwner(tripId) || uid() == memberId || isSuperAdmin();
      }

      // Itinerary (cities → days → activities): any member writes; viewers read.
      match /cities/{cityId} {
        allow read: if isTripMember(tripId) || isAdmin();
        allow write: if isTripMember(tripId);
        match /{sub=**} {
          allow read: if isTripMember(tripId) || isAdmin();
          allow write: if isTripMember(tripId);
        }
      }

      // Finance: one shared doc (kitty + group/side expenses, any member writes)
      // and one self-scoped personal doc per user (personal_<uid>).
      match /finance/{docId} {
        allow read: if isTripMember(tripId);
        allow write: if isTripMember(tripId)
                     && (docId == 'shared' || docId == ('personal_' + uid()));
      }

      // Kitty: owner sets total / marks paid; members read. (legacy path)
      match /kitty/{doc} {
        allow read: if isTripMember(tripId);
        allow write: if isTripOwner(tripId);
      }
      // Group/side expenses: members create; creator or owner edits/deletes.
      match /expenses/{expenseId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId) && request.resource.data.creatorUid == uid();
        allow update, delete: if isTripMember(tripId)
                              && (resource.data.creatorUid == uid() || isTripOwner(tripId));
      }
      // Personal spend: strictly self-scoped.
      match /personal/{userId}/{doc=**} {
        allow read, write: if signedIn() && uid() == userId && isTripMember(tripId);
      }

      // Tasks / packing / bookings: any member writes.
      match /tasks/{taskId}    { allow read: if isTripMember(tripId); allow write: if isTripMember(tripId); }
      match /packing/{itemId}  { allow read: if isTripMember(tripId); allow write: if isTripMember(tripId); }
      match /bookings/{itemId} { allow read: if isTripMember(tripId); allow write: if isTripMember(tripId); }

      // Memories: members read/upload; uploader or owner deletes.
      match /memories/{mediaId} {
        allow read: if isTripMember(tripId) || isAdmin();
        allow create: if isTripMember(tripId) && request.resource.data.uploaderUid == uid();
        allow update: if isTripMember(tripId) && resource.data.uploaderUid == uid();
        allow delete: if isTripOwner(tripId) || (isTripMember(tripId) && resource.data.uploaderUid == uid());
      }
    }

    // ── Friends (self-scoped social graph) ─────────────────────────────────
    match /friends/{userId}/{doc=**} {
      allow read, write: if signedIn() && uid() == userId;
    }

    // ── Buddies (public browse; owner edits own) ───────────────────────────
    match /buddies/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == uid();
      allow update, delete: if (signedIn() && resource.data.ownerUid == uid()) || isAdmin();
    }

    // ── Places (community recommendations) + self reviews ──────────────────
    // Any signed-in traveller may add/refresh a place they added to a trip
    // (feeds the "traveller picks" recommendations); admins may curate/remove.
    match /places/{placeId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow write: if signedIn() && uid() == reviewId;
      }
    }

    // ── Partners directory (curated, read-only for users) ──────────────────
    match /partners/{partnerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── Notifications (recipient-scoped) ───────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read: if signedIn() && uid() == userId;
      allow create, update, delete: if signedIn() && uid() == userId;
    }

    // ── Audit / config (admin only) ────────────────────────────────────────
    match /audit/{entryId} { allow read: if isAdmin(); allow write: if false; }
    match /config/{doc}    { allow read: if isAdmin(); allow write: if isSuperAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
