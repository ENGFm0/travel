    "privacy": {
      "title": "سياسة الخصوصية",
      "lead": "نوضّح هنا ما الذي نحفظه من بياناتك، ولماذا، ومن يمكنه الاطلاع عليه.",
      "sections": [
        { "h": "ما الذي نحفظه", "p": "عند إنشاء حساب نحفظ اسمك وبريدك الإلكتروني ورقم جوالك (اختياري) واسم المستخدم والصورة الرمزية. وعند التخطيط لرحلة نحفظ عنوان الرحلة وتواريخها ومدنها وجدولها اليومي ومصاريفها ومهامها وصورها التي ترفعها." },
        { "h": "الإيبان", "p": "يُحفظ الإيبان على ملفك الشخصي ويُنسخ إلى سجلّ عضويتك في كل رحلة تشارك فيها، ولا يراه إلا أعضاء تلك الرحلة لغرض تحويل التسويات إليك. لا يظهر لأي شخص خارج رحلاتك ولا يُستخدم لأي غرض آخر." },
        { "h": "أين تُخزَّن البيانات", "p": "يعمل التطبيق على منصة Firebase من Google: المصادقة (Authentication) وقاعدة البيانات (Firestore) والاستضافة (Hosting). تُنقل البيانات مشفّرة عبر HTTPS وتُخزَّن في مراكز بيانات Google وفق شروطها الأمنية." },
        { "h": "من يرى بياناتك", "p": "بيانات الرحلة (الجدول والمصاريف والصور) مرئية لأعضاء الرحلة فقط. ملفك الشخصي خاص بك، ما عدا الاسم واسم المستخدم اللذين يُستخدمان حتى يعثر عليك أصدقاؤك. لا نبيع بياناتك ولا نشاركها مع معلنين." },
        { "h": "الخدمات الخارجية", "p": "لعرض الأماكن والصور والخرائط نستخدم خرائط Google، ولبيانات الطيران نستخدم خدمة AeroDataBox. تتلقى هذه الخدمات استعلامات البحث فقط دون بياناتك الشخصية." },
        { "h": "التقارير وملفات PDF", "p": "تقرير الرحلة وملف PDF يُنشآن على جهازك، وما تشاركه منهما يكون بقرارك ومسؤوليتك." },
        { "h": "حذف بياناتك", "p": "يمكنك حذف حسابك وبياناتك في أي وقت من صفحة الحساب. إذا كنت المالك الوحيد لرحلة نشطة بها أعضاء، فانقل الملكية أولًا. تُحذف البيانات نهائيًا بعد فترة احتفاظ قصيرة." }
      ]
    },
    "terms": {
      "title": "شروط الخدمة",
      "lead": "باستخدامك بوردنق باس فأنت توافق على هذه الشروط المختصرة.",
      "sections": [
        { "h": "الخدمة", "p": "بوردنق باس أداة لتنظيم رحلات المجموعات: الجدول والمصاريف والمهام والذكريات. الخدمة مقدَّمة كما هي، ونعمل على تطويرها باستمرار." },
        { "h": "الاستخدام المقبول", "p": "استخدم التطبيق لأغراض مشروعة فقط. لا ترفع محتوى يسيء للآخرين أو ينتهك حقوقهم، ولا تحاول الوصول إلى بيانات رحلات لست عضوًا فيها." },
        { "h": "الحجوزات والمدفوعات", "p": "التطبيق لا يبيع تذاكر ولا يحجز فنادق ولا يحوّل أموالًا. أي حجز تجريه عبر مواقع خارجية يخضع لشروط تلك المواقع، ولا نتحمّل مسؤولية عنه." },
        { "h": "التسويات بين الأعضاء", "p": "حسابات المصاريف وتقسيمها أداة مساعدة؛ التحويلات بين الأعضاء تتم خارج التطبيق وتبقى مسؤولية الأعضاء أنفسهم. تأكد من الإيبان قبل التحويل." },
        { "h": "نسبة التطبيق", "p": "النسبة المقترحة لدعم التطبيق تطوّعية بالكامل وفي ذمة المستخدم، ولا تترتب عليها أي التزامات." },
        { "h": "الشركاء والعروض", "p": "عروض الشركاء المعروضة في قسم استكشف مقدَّمة من جهات مستقلة، ولا نضمن محتواها أو أسعارها." },
        { "h": "التعديلات", "p": "قد نحدّث هذه الشروط من وقت لآخر، وسنشير إلى تاريخ آخر تحديث في أعلى الصفحة." }
      ]
    },
    "help": {
      "title": "مركز المساعدة",
      "lead": "إجابات سريعة عن أكثر الأسئلة شيوعًا.",
      "sections": [
        { "h": "كيف أنشئ رحلة؟", "p": "من الصفحة الرئيسية اضغط «ابدأ رحلة جديدة»، واكتب العنوان والنوع والتواريخ والوجهة الأولى. بعد الإنشاء تضيف المدن والسكن والتنقّل من داخل الرحلة." },
        { "h": "كيف أدعو الأعضاء؟", "p": "من تبويب «الأعضاء» داخل الرحلة: ادعُ بالاسم أو برقم الجوال أو اسم المستخدم، أو شارك رابط الدعوة. المدعو يحتاج إلى تسجيل الدخول ليقبل الدعوة." },
        { "h": "ما الفرق بين أنواع القطة؟", "p": "القطة «المحددة» مبلغ يُجمع مسبقًا من كل الأعضاء بالتساوي وتُخصم منه المصاريف. القطة «غير المحددة» بلا مبلغ مسبق: من يدفع يحدّد من معه ويُقسَّم المبلغ عليهم. المصاريف «الشخصية» لا تدخل في الحساب وتراها أنت فقط." },
        { "h": "كيف تُحسب التسوية؟", "p": "في «ملخّصي» يظهر من يدفع لمن وبالهللة. الوضع «مباشر» يجعل كل شخص يدفع لمن دفع عنه فعلًا، والوضع «مختصر» يقلّل عدد التحويلات. المجموع في الأعلى يساوي دائمًا مجموع التحويلات في الأسفل." },
        { "h": "لماذا يُطلب مني الإيبان؟", "p": "حتى يستطيع أعضاء الرحلة تحويل مستحقاتك إليك. يُحفظ مرة واحدة في صفحة الحساب ويظهر لأعضاء رحلاتك فقط، ويتعرّف التطبيق على بنكك تلقائيًا من الرقم." },
        { "h": "كيف أصدّر التقرير أو ملف PDF؟", "p": "من تبويب «الذكريات»: «عرض التقرير» يفتح لوحة الرحلة كاملة، و«تحميل PDF» ينشئ ملفًا بحجم الجوال فيه الجدول والمصاريف والصور بجودة عالية، مع معاينة قبل الحفظ أو المشاركة." },
        { "h": "لم يصلني شيء / حدث خطأ", "p": "تأكد من الاتصال بالإنترنت وحدّث الصفحة. إن استمرت المشكلة راسلنا على البريد أدناه مع وصف قصير لما حدث." }
      ]
    }
